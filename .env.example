# =================================================================
# CẤU HÌNH MÔI TRƯỜNG CHO VPS LINUX & LOCAL DEVELOPMENT
# Sao chép tệp này thành .env và điền các thông tin phù hợp
# =================================================================

# Cổng khởi chạy ứng dụng Node.js
PORT=3000

# Địa chỉ IP lắng nghe (0.0.0.0 áp dụng cho VPS Linux để truy cập từ ngoài)
HOST=0.0.0.0

# Secret Key bảo mật cho API Đồng bộ Code 1-Click
SYNC_SECRET_TOKEN=vps_sync_secret_key_2026

# Cấu hình kết nối MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_inventory

# Cấu hình Facebook Messenger Page Bot
FB_VERIFY_TOKEN=smart_inventory_messenger_verify_token_2026
FB_PAGE_ACCESS_TOKEN=EAAG...your_page_access_token...
FB_APP_SECRET=your_app_secret_here

